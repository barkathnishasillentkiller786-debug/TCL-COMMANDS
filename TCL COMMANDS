-- TCL COMMANDS IN DBMS

-- 1. CREATE DATABASE
CREATE DATABASE College;

-- 2. SELECT DATABASE
USE College;

-- 3. CREATE TABLE
CREATE TABLE Student (
    RollNo INT PRIMARY KEY,
    Name VARCHAR(50),
    Age INT,
    Marks INT
) ENGINE = InnoDB;

-- 4. INSERT INITIAL RECORDS
INSERT INTO Student VALUES
(1, 'Nisha', 20, 90),
(2, 'Ayesha', 21, 85),
(3, 'Rahul', 20, 88);

-- 5. COMMIT INITIAL RECORDS
COMMIT;

-- 6. START A TRANSACTION
START TRANSACTION;

-- 7. INSERT A NEW RECORD
INSERT INTO Student VALUES
(4, 'Priya', 22, 92);

-- 8. SAVE CHANGES
COMMIT;

-- 9. START ANOTHER TRANSACTION
START TRANSACTION;

-- 10. INSERT A RECORD
INSERT INTO Student VALUES
(5, 'Arun', 21, 80);

-- 11. CREATE SAVEPOINT
SAVEPOINT S1;

-- 12. UPDATE A RECORD
UPDATE Student
SET Marks = 95
WHERE RollNo = 1;

-- 13. ROLLBACK TO SAVEPOINT
ROLLBACK TO SAVEPOINT S1;

-- 14. DISPLAY RECORDS
SELECT * FROM Student;

-- 15. COMMIT REMAINING CHANGES
COMMIT;

-- 16. DISPLAY FINAL RECORDS
SELECT * FROM Student;
